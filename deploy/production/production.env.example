# Paths only. Secret material belongs in root/service-UID restricted files and
# must never be copied into this file or passed as direct environment values.
COMPOSE_PROJECT_NAME=tsing-radar-prod
SECRET_ROOT=/etc/tsing-radar/secrets/prod
STAGE_SECRET_ROOT=/etc/tsing-radar/secrets/stage
BOOTSTRAP_SECRET_ROOT=/etc/tsing-radar/secrets/bootstrap

# Replace every image with an immutable, independently verified digest.
POSTGRES_IMAGE=postgres@sha256:<digest>
REDIS_IMAGE=redis@sha256:<digest>
ETCD_IMAGE=etcd@sha256:<digest>
MINIO_IMAGE=minio@sha256:<digest>
MILVUS_IMAGE=milvus@sha256:<digest>
CLAMAV_IMAGE=clamav@sha256:<digest>
BACKEND_IMAGE=tsing-radar-backend@sha256:<digest>
FRONTEND_IMAGE=tsing-radar-frontend@sha256:<digest>
CADDY_IMAGE=caddy@sha256:<digest>
NGINX_UNPRIVILEGED_IMAGE=nginx-unprivileged@sha256:<digest>

PROD_DATABASE_NAME=tsing_radar_prod
PROD_DATABASE_USER=tsing_radar_prod
DATABASE_BOOTSTRAP_USER=tsing_radar_bootstrap
MILVUS_BUCKET=tsing-radar-milvus
PROD_COS_BUCKET=<private-prod-bucket-appid>
PROD_CORS_ORIGINS=https://<approved-web-host>

STAGE_DATABASE_NAME=tsing_radar_stage
STAGE_DATABASE_USER=tsing_radar_stage
STAGE_COS_BUCKET=<private-stage-bucket-appid>
STAGE_CORS_ORIGINS=https://<approved-stage-host>

# These hosts are inert until their separate atomic overlay is explicitly
# approved and selected. Do not populate them as an implied release action.
WEB_HOST=<approved-web-host>
QXD_HOST=<separately-approved-qxd-host>
MEDIA_HOST=<separately-approved-media-host>
BACKUP_FILE=<verified-backup-filename.dump>
JOB_LOCK_FILE=/var/lib/tsing-radar/job.lock
JOB_LOCK_GID=10002
