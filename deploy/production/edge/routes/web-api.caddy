(backend_proxy) {
    request_body {
        max_size 1MB
    }
    reverse_proxy backend:8000 {
        header_up -Forwarded
        header_up -X-Forwarded-For
        header_up -X-Forwarded-Host
        header_up -X-Forwarded-Port
        header_up -X-Forwarded-Proto
        header_up -X-Real-IP
        transport http {
            dial_timeout 3s
            response_header_timeout 30s
        }
    }
}

(backend_upload_proxy) {
    request_body {
        # Leave enough multipart framing room for an 8 MiB file while making
        # clearly oversized requests fail at the edge with HTTP 413.
        max_size 8500KB
    }
    reverse_proxy backend:8000 {
        header_up -Forwarded
        header_up -X-Forwarded-For
        header_up -X-Forwarded-Host
        header_up -X-Forwarded-Port
        header_up -X-Forwarded-Proto
        header_up -X-Real-IP
        transport http {
            dial_timeout 3s
            response_header_timeout 30s
        }
    }
}

{$WEB_HOST} {
    header -Server

    @forwarded header Forwarded *
    respond @forwarded "Forwarded headers are not accepted" 400

    @public_get {
        method GET
        path /health/live /health/ready /api/session /api/web-test-mode /api/mentors /api/mentors/sort /api/departments /api/departments/mentors /api/departments/students /api/mentor-evidence/status /api/mentor-distribution /api/recruitments /api/recruitments/mine /api/scatter /api/applications /api/documents /api/interviews/hard-constraint-capabilities /api/interest-exploration/question /api/ratings/mine /api/mentor/auth/status /api/mentor/claim/eligible /api/mentor/claim/history /api/mentor /api/mentor/profile/edits /api/mentor/inbound/matches /api/mentor/inbound/applications /api/mentor/inbound/feedback /api/mentor/recruitments /api/mentor/privacy /api/mentor/privacy/takedowns /api/mentor/verification/campus-card /api/admin/mentor/claims /api/admin/mentor/profile-edits /api/admin/mentor/takedowns /api/admin/mentor/campus-cards /api/admin/mentor/comments
    }
    handle @public_get {
        import backend_proxy
    }

    @public_get_dynamic {
        method GET
        path_regexp public_get_dynamic ^/api/(interviews/[A-Za-z0-9_-]+|applications/[A-Za-z0-9_-]+|documents/[A-Za-z0-9_-]+|recruitments/[A-Za-z0-9_-]+(/comments)?|advisors/[A-Za-z0-9_-]+/ratings(/summary)?)$
    }
    handle @public_get_dynamic {
        import backend_proxy
    }

    @public_post {
        method POST
        path /api/feedback /api/interviews /api/match /api/recruitments /api/applications /api/v1/llm/chat /api/resume/generate /api/resume/submit /api/artifacts/match-report /api/interest-exploration/suggestions /api/mentor/auth/email-code /api/mentor/auth/login /api/mentor/auth/logout /api/mentor/claim /api/mentor/profile/edits /api/mentor/recruitments /api/mentor/privacy/takedowns
    }
    handle @public_post {
        import backend_proxy
    }

    @private_document_upload {
        method POST
        path /api/documents
    }
    handle @private_document_upload {
        import backend_upload_proxy
    }

    @document_analysis {
        method POST
        path_regexp document_analysis ^/api/documents/[A-Za-z0-9_-]+/(analysis|interpretation)$
    }
    handle @document_analysis {
        import backend_proxy
    }

    @artifact_delivery {
        method POST
        path_regexp artifact_delivery ^/api/artifacts/([A-Za-z0-9_-]+/download-grant|download/[A-Za-z0-9._~-]+)$
    }
    handle @artifact_delivery {
        import backend_proxy
    }

    @interview_answer {
        method POST
        path_regexp interview_answer ^/api/interviews/[A-Za-z0-9_-]+/(answers|confirm|enhancement-retry)$
    }
    handle @interview_answer {
        import backend_proxy
    }

    @interest_exploration_apply {
        method POST
        path_regexp interest_exploration_apply ^/api/interest-exploration/[A-Za-z0-9_-]+/apply$
    }
    handle @interest_exploration_apply {
        import backend_proxy
    }

    @campus_card_upload {
        method POST
        path /api/mentor/verification/campus-card
    }
    handle @campus_card_upload {
        import backend_upload_proxy
    }

    @rating_submit {
        method POST
        path_regexp rating_submit ^/api/advisors/[A-Za-z0-9_-]+/ratings$
    }
    handle @rating_submit {
        import backend_proxy
    }

    @recruitment_comment {
        method POST
        path_regexp recruitment_comment ^/api/recruitments/[A-Za-z0-9_-]+/comments(/[A-Za-z0-9_-]+/(like|report))?$
    }
    handle @recruitment_comment {
        import backend_proxy
    }

    @admin_mentor_review {
        method POST
        path_regexp admin_mentor_review ^/api/admin/mentor/[a-z-]+/[A-Za-z0-9_-]+/review$
    }
    handle @admin_mentor_review {
        import backend_proxy
    }

    @profile_or_application_patch {
        method PATCH
        path_regexp patch_paths ^/api/(interviews/[A-Za-z0-9_-]+/profile|applications/[A-Za-z0-9_-]+|recruitments/[A-Za-z0-9_-]+|mentor/recruitments/[A-Za-z0-9_-]+|mentor/privacy/visibility)$
    }
    handle @profile_or_application_patch {
        import backend_proxy
    }

    @session_delete {
        method DELETE
        path /api/session
    }
    handle @session_delete {
        import backend_proxy
    }

    @owned_resource_delete {
        method DELETE
        path_regexp owned_resource_delete ^/api/(applications/[A-Za-z0-9_-]+|documents/[A-Za-z0-9_-]+|recruitments/[A-Za-z0-9_-]+|recruitments/[A-Za-z0-9_-]+/comments/[A-Za-z0-9_-]+|mentor/recruitments/[A-Za-z0-9_-]+)$
    }
    handle @owned_resource_delete {
        import backend_proxy
    }

    @cors_preflight {
        method OPTIONS
        path_regexp cors_paths ^/(health/(live|ready)|api/(session|web-test-mode|mentors(/sort)?|departments(/(mentors|students))?|mentor-evidence/status|mentor-distribution|recruitments(/mine|/[A-Za-z0-9_-]+(/comments(/[A-Za-z0-9_-]+/(like|report))?)?)?|scatter|feedback|match|v1/llm/chat|resume/(generate|submit)|interest-exploration/(question|suggestions|[A-Za-z0-9_-]+/apply)|ratings/mine|advisors/[A-Za-z0-9_-]+/ratings(/summary)?|interviews(/[A-Za-z0-9_-]+(/(answers|confirm|profile|enhancement-retry))?)?|applications(/[A-Za-z0-9_-]+)?|documents(/[A-Za-z0-9_-]+(/(analysis|interpretation))?)?|artifacts/(match-report|[A-Za-z0-9_-]+/download-grant|download/[A-Za-z0-9._~-]+)|mentor(/(auth/(status|email-code|login|logout)|claim(/eligible|/history)?|profile/edits|inbound/(matches|applications|feedback)|recruitments(/[A-Za-z0-9_-]+)?|privacy(/visibility|/takedowns)?|verification/campus-card))?|admin/mentor(/[a-z-]+(/[A-Za-z0-9_-]+/review)?)?))$
    }
    handle @cors_preflight {
        import backend_proxy
    }

    @static {
        method GET HEAD
        not path /api/* /v1/* /health/*
    }
    handle @static {
        reverse_proxy frontend:80 {
            header_up -Forwarded
            header_up -X-Forwarded-For
            header_up -X-Forwarded-Host
            header_up -X-Forwarded-Port
            header_up -X-Forwarded-Proto
            header_up -X-Real-IP
            transport http {
                dial_timeout 3s
                response_header_timeout 15s
            }
        }
    }

    # Every backend route not explicitly matched above is denied. In
    # particular docs, OpenAPI, LLM embeddings, training/admin, scraper,
    # attachments and /v1 are absent. Private document and artifact routes above
    # remain session-bound and are listed individually.
    respond "Route or method not available" 404
}
