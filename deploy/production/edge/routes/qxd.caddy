{$QXD_HOST} {
    header -Server
    request_body {
        max_size 128KB
    }
    reverse_proxy qxd-gateway:8080 {
        header_up -Forwarded
        header_up -X-Forwarded-For
        header_up -X-Forwarded-Host
        header_up -X-Forwarded-Port
        header_up -X-Forwarded-Proto
        header_up -X-Real-IP
        transport http {
            dial_timeout 3s
            response_header_timeout 115s
        }
        flush_interval -1
    }
}
