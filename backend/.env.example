# Tsing-RADAR 后端环境配置示例
# 复制为 .env 并填入真实值

# ===== 大模型 =====
# 生产环境：只配置 provider 与只读密钥文件路径，不把密钥写入环境变量。
LLM_PROVIDER=
LLM_API_KEY_FILE=
# 本地开发兼容变量（生产环境拒绝）：
# 智谱 GLM：https://open.bigmodel.cn/
GLM_API_KEY=

# ===== 腾讯云 COS（香港生产目标；凭证仍使用 *_FILE）=====
OBJECT_STORE_BACKEND=s3
S3_PROVIDER=tencent_cos
S3_REGION=ap-hongkong
S3_ENDPOINT_URL=https://cos.ap-hongkong.myqcloud.com
S3_ADDRESSING_STYLE=virtual
S3_SERVER_SIDE_ENCRYPTION=AES256
S3_BUCKET=
S3_ACCESS_KEY_ID_FILE=
S3_SECRET_ACCESS_KEY_FILE=

# ===== 数据库 =====
# 开发期默认 SQLite（开箱即用），生产期切换 PostgreSQL：
# DATABASE_URL=postgresql://tsingradar:***@db:5432/tsingradar
DATABASE_URL=sqlite:///./tsing_radar.db

# ===== Redis（可选）=====
# REDIS_URL=redis://redis:6379/0

# ===== 导师服务邮件（邮箱验证码登录）=====
# console=仅打印到服务端日志（开发/测试）；smtp=真实发送（生产）
MAIL_MODE=console
# MAIL_HOST=smtp.tsinghua.edu.cn
# MAIL_PORT=465
# MAIL_USER=
# MAIL_PASSWORD=
# MAIL_FROM=Tsing-RADAR 导师服务 <no-reply@tsingradar.com.cn>

# ===== 管理员 =====
ADMIN_TOKEN=admin

# ===== 清小搭平台 =====
# APP_KEY=qingxiaoda-assigned-key
# QXD_BASE_URL=

# ===== CORS（逗号分隔）=====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,null

# ===== 调试 =====
DEBUG=true
