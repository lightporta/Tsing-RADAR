# Tsing-RADAR 后端环境配置示例
# 复制为 .env 并填入真实值（cp .env.example .env）
#
# ────────────────────────────────────────────────────────────────
# 数据库（必填，MySQL 8.x）
# ────────────────────────────────────────────────────────────────
# 本地需提前启动 MySQL 8.x 并创建空数据库 teacher_db（不要手动建表，交给 alembic）：
#
#   # Docker 一行启动（推荐）：
#   docker run -d --name tsing-mysql -p 3306:3306 \
#     -e MYSQL_ROOT_PASSWORD=password \
#     -e MYSQL_DATABASE=teacher_db \
#     mysql:8.0 \
#     --character-set-server=utf8mb4 \
#     --collation-server=utf8mb4_unicode_ci
#
#   # Mac brew：
#   brew install mysql@8
#   brew services start mysql@8
#   mysql -uroot -e "CREATE DATABASE teacher_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
#
# 替换下面 ip/账号/密码即可指向任意 MySQL 8 实例（本地/生产同方言，迁移文件直接复用）：
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/teacher_db?charset=utf8mb4

# ────────────────────────────────────────────────────────────────
# 大模型（必填，接真模型用）
# ────────────────────────────────────────────────────────────────
# 智谱 GLM：https://open.bigmodel.cn/
GLM_API_KEY=
# DeepSeek（GLM 异常时兜底）：https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# ────────────────────────────────────────────────────────────────
# 管理员（数据发布门禁；生产期必须改强随机）
# ────────────────────────────────────────────────────────────────
ADMIN_TOKEN=admin

# ────────────────────────────────────────────────────────────────
# 可选组件（留空则降级）
# ────────────────────────────────────────────────────────────────
# Redis（缓存）：未配置时降级为内存缓存
# REDIS_URL=redis://127.0.0.1:6379/0

# 向量数据库（语义检索）：未配置时降级为 hash 伪向量
# MILVUS_HOST=127.0.0.1
# MILVUS_PORT=19530

# 邮件（清华 SMTP，OAuth 2.0）
# SMTP_HOST=smtp.tsinghua.edu.cn
# SMTP_USER=
# SMTP_PASSWORD=

# 清小搭平台
# APP_KEY=
# QXD_BASE_URL=
# PUBLIC_BASE_URL=

# ────────────────────────────────────────────────────────────────
# 对象存储 / 下载签名（v2.2）
# ────────────────────────────────────────────────────────────────
# STORAGE_BACKEND=local
# STORAGE_LOCAL_DIR=./storage_objects
# STORAGE_BUCKET=tsing-radar
# 生产期必须从环境变量注入强随机值：
# DOWNLOAD_SIGNING_SECRET=
# DOWNLOAD_TOKEN_TTL=300
# MAX_UPLOAD_BYTES=26214400
# MAX_DOWNLOAD_BYTES=104857600
# MAX_PDF_PAGES=100

# ────────────────────────────────────────────────────────────────
# 其他（一般无需修改）
# ────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,null
DEBUG=true
