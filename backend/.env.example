# Tsing-RADAR 后端环境配置示例
# 复制为 .env 即可运行本地规则 + 合成导师演示，无需模型密钥或云资源。

# ===== 大模型 =====
# 本地演示显式关闭外部模型；接开发模型时改为 true 并配置一个 provider Key。
LLM_ENABLED=false
# LLM_PROVIDER=glm
# 生产配置使用 deploy/production/production.env.example 与独立 *_FILE 密钥。
# LLM_API_KEY_FILE=/run/secrets/llm_api_key
# 本地开发兼容变量（生产环境拒绝）：
# 智谱 GLM：https://open.bigmodel.cn/
GLM_API_KEY=
# DeepSeek：https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# ===== 本地私有文件 =====
OBJECT_STORE_BACKEND=local
PRIVATE_UPLOAD_ROOT=./private_uploads
# PDF 需可嵌入的中文 TrueType 字体；默认探测 macOS/Windows/Linux 系统字体。
# DOCUMENT_CJK_FONT_PATH=/absolute/path/to/chinese-font.ttf

# ===== 数据库 =====
# 开发期默认 SQLite（开箱即用），生产期切换 PostgreSQL：
# DATABASE_URL=postgresql+psycopg://tsingradar:***@db:5432/tsingradar
DATABASE_URL=sqlite:///./tsing_radar.db

# ===== Redis（可选）=====
# REDIS_URL=redis://redis:6379/0

# ===== 向量数据库（可选）=====
# MILVUS_HOST=vector-db
# MILVUS_PORT=19530

# ===== 邮件（清华 SMTP，OAuth 2.0）=====
# SMTP_HOST=smtp.tsinghua.edu.cn
# SMTP_USER=
# SMTP_PASSWORD=

# ===== 管理员 =====
# ADMIN_TOKEN=replace-with-a-local-admin-token

# ===== 清小搭平台 =====
# APP_KEY=qingxiaoda-assigned-key
# QXD_BASE_URL=

# ===== CORS（逗号分隔）=====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,null

# ===== 调试 =====
DEBUG=true
# 本地 UX 演示用合成导师（姓名带【模拟】前缀）。仅 DEBUG=true 且
# PRODUCTION_DEPLOYMENT=false 时可开启；生产启动会拒绝。
ALLOW_SIMULATION_MENTORS=true
