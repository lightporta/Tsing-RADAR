# Tsing-RADAR 后端环境配置示例
# 复制为 .env 并填入真实值

# ===== 大模型（必填，接真模型用）=====
# 智谱 GLM：https://open.bigmodel.cn/
GLM_API_KEY=
# DeepSeek（GLM 异常时兜底）：https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# ===== 数据库 =====
# 开发期默认 SQLite（开箱即用），生产期切换 PostgreSQL：
# DATABASE_URL=postgresql://tsingradar:***@db:5432/tsingradar
DATABASE_URL=sqlite:///./tsing_radar.db

# ===== Redis（可选）=====
# REDIS_URL=redis://redis:6379/0

# ===== 向量数据库（可选）=====
# MILVUS_HOST=vector-db
# MILVUS_PORT=19530

# ===== 邮件（清华 SMTP，OAuth 2.0）=====
# SMTP_HOST=smtp.tsinghua.edu.cn
# SMTP_USER=
# SMTP_PASSWORD=

# ===== 管理员 =====
ADMIN_TOKEN=admin

# ===== 清小搭平台 =====
# APP_KEY=qingxiaoda-assigned-key
# QXD_BASE_URL=

# ===== CORS（逗号分隔）=====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,null

# ===== 调试 =====
DEBUG=true
